{
    "name": "restapitoolkit/rest-api-toolkit",
    "description": "REST API infrastructure layer for WordPress and WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "RestApiToolkit\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
